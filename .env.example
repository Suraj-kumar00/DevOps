# Copy to .env.local for local development. Every variable is optional.

# Public URL of the deployed site, used for canonical URLs, the sitemap, Open Graph images and
# the MCP example on the home page. Set it at build time; on Vercel it defaults to the
# production domain, elsewhere to http://localhost:3000.
SITE_URL=

# Your Hashnode publication ID, used by the newsletter form (find it in your blog dashboard on Hashnode).
# When empty, the site shows a "Follow the blog" link instead of the form.
HASHNODE_PUBLICATION_ID=
